@startuml
' ============================================================================
' C4 Level 1 - System Context
' 系统：pi-wechat-extension（将微信接入 pi coding agent 的双向消息通道）
'
' 事实来源：docs/ARCHITECTURE.md
' 说明：本图为 Context 层，仅描述系统边界与外部角色/外部系统，
'       不描述插件内部结构（见 03-components.puml）。
' ============================================================================

!include <C4/C4_Context>
' 若本地 PlantUML 未内置 C4 stdlib，可改用：
' !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title System Context — pi-wechat-extension

' --- 角色（Person）--------------------------------------------------------
Person(wechatUser, "微信用户", "单用户：通过微信 App 与 AI 对话")
Person(operator, "开发者 / 操作者", "在 pi 终端扫码登录、执行 /wechat 命令、查看日志")

' --- 系统（System of interest）-------------------------------------------
System(plugin, "pi-wechat-extension", "微信 <-> pi 的双向消息通道；作为进程内扩展运行于 pi 运行时")

' --- 外部系统（System_Ext）-----------------------------------------------
System_Ext(piRuntime, "pi coding agent 运行时", "宿主进程：提供 ExtensionAPI、会话与 agent 生命周期、LLM 访问")
System_Ext(wechatBackend, "微信 iLink 后端", "长轮询收消息、发送文本/媒体、上传下载、typing、登录鉴权")
System_Ext(fileSystem, "本地文件系统", "~/.pi/agent/wechat/ 凭证与媒体目录")
System_Ext(llmProvider, "LLM 提供商", "经 pi 运行时间接访问的大模型服务")

' --- 关系（Rel）----------------------------------------------------------
Rel(wechatUser, plugin, "发送 / 接收微信消息", "微信 App")
Rel(operator, plugin, "登录 / 查看状态 / 启停轮询", "/wechat 命令")
Rel(plugin, operator, "展示二维码与连接状态", "终端 / UI 通知")

Rel(plugin, piRuntime, "注册工具 / 命令 / 事件；注入用户消息", "ExtensionAPI（in-process）")
Rel(plugin, wechatBackend, "长轮询 / 发送 / 上传下载 / typing", "HTTPS")
Rel(plugin, fileSystem, "读写凭证、cursor、context token 与媒体文件", "fs")
Rel(piRuntime, llmProvider, "生成回复", "HTTPS（经 pi，非插件直连）")

LAYOUT_WITH_LEGEND()
@enduml
