@startuml
' ============================================================================
' C4 Level 1 - System Context
' 系统：pi-wechat-extension（将微信接入 pi coding agent 的双向消息通道）
'
' 事实来源：docs/ARCHITECTURE.md
' 布局：中心为系统；左侧为宿主/基础设施（pi 运行时 / LLM / 文件系统）；
'       右侧为微信侧（用户 + 微信 App + iLink 后端），用户与微信的交互链集中在一侧。
' 说明：本图为 Context 层，仅描述系统边界与外部角色/外部系统，
'       不描述插件内部结构（见 03-components.puml）。
' 角色模型：只有「用户」一个 Person；微信是外部平台（拆分为 App 与 iLink 后端）。
' ============================================================================

!include <C4/C4_Context>
' 若本地 PlantUML 未内置 C4 stdlib，可改用：
' !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title System Context — pi-wechat-extension

' --- 系统（System of interest，居中）-------------------------------------
System(plugin, "pi-wechat-extension", "微信 <-> pi 的双向消息通道；作为进程内扩展运行于 pi 运行时")

' --- 左侧：宿主 / 基础设施（就近成组，无包含语义）---------------------------
together {
  System_Ext(piRuntime, "pi coding agent 运行时", "宿主进程：提供 ExtensionAPI、会话与 agent 生命周期、LLM 访问")
  System_Ext(llmProvider, "LLM 提供商", "经 pi 运行时间接访问的大模型服务")
  System_Ext(fileSystem, "本地文件系统", "~/.pi/agent/wechat/ 凭证与媒体目录")
}

' --- 右侧：微信侧（用户 + 平台，交互链集中）--------------------------------
together {
  Person(user, "用户", "唯一用户；首次使用需先在 pi 终端绑定微信账号，之后通过微信与 AI 对话")
  System_Ext(wechatApp, "微信 App", "用户使用的微信客户端：收发消息、扫码确认登录")
  System_Ext(ilinkBackend, "微信 iLink 后端", "插件对接的机器人后端 API：长轮询、发送、上传下载、typing、登录鉴权")
}

' --- 关系（方向性宏驱动布局）----------------------------------------------
' 终端路径：绑定账号与管理（用户 <-> 插件，横向）
Rel_Left(user, plugin, "首次使用：在 pi 终端执行 /wechat login 绑定微信账号；查看状态 / 启停轮询", "终端命令")
Rel_Right(plugin, user, "展示登录二维码与连接状态", "终端 / UI 通知")

' 微信路径：聊天（右侧内部自上而下，再横向接入插件）
Rel_Down(user, wechatApp, "收发微信消息、扫码确认登录", "微信 App")
Rel_Down(wechatApp, ilinkBackend, "发送消息 / 扫码确认", "平台内部")
Rel_Up(ilinkBackend, wechatApp, "投递消息", "平台内部")
Rel_Left(ilinkBackend, plugin, "返回新消息 / 登录结果", "HTTPS")
Rel_Right(plugin, ilinkBackend, "请求登录二维码 / 长轮询 / 发送回复与媒体 / typing", "HTTPS")

' 宿主与基础设施（插件 <-> 左侧，横向）
Rel_Left(plugin, piRuntime, "注册工具 / 命令 / 事件；注入用户消息", "ExtensionAPI（in-process）")
Rel_Down(piRuntime, llmProvider, "生成回复", "HTTPS（经 pi，非插件直连）")
Rel_Left(plugin, fileSystem, "读写凭证、cursor、context token 与媒体文件", "fs")

' --- 布局微调：固定左侧纵向次序 -------------------------------------------
Lay_D(llmProvider, fileSystem)

' --- 前置说明 ------------------------------------------------------------
note as Precondition
  **前置条件** — 首次使用需先在 pi 终端执行 `/wechat login` 扫码绑定微信账号；
  绑定成功后插件才会自动连接并收发微信消息（绑定前微信侧无法触达插件）。
end note

LAYOUT_WITH_LEGEND()
@enduml
