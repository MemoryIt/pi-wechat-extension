@startuml
' ============================================================================
' C4 Level 1 - System Context
' 系统：pi-wechat-extension（将微信接入 pi coding agent 的双向消息通道）
'
' 事实来源：docs/ARCHITECTURE.md
' 说明：本图为 Context 层，仅描述系统边界与外部角色/外部系统，
'       不描述插件内部结构（见 03-components.puml）。
' 角色模型：只有「用户」一个 Person；微信是外部平台（拆分为 App 与 iLink 后端）。
' 外部系统：pi coding agent 作为整体（其运行时/文件存储/LLM 细节不在本层暴露）。
' ============================================================================

!include <C4/C4_Context>
' 若本地 PlantUML 未内置 C4 stdlib，可改用：
' !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title System Context — pi-wechat-extension

' --- 角色（Person，唯一）-------------------------------------------------
Person(user, "用户", "唯一用户；首次使用需先在 pi 终端绑定微信账号，之后通过微信与 AI 对话")

' --- 系统（System of interest）-------------------------------------------
System(plugin, "pi-wechat-extension", "微信 <-> pi 的双向消息通道；作为进程内扩展运行于 pi coding agent")

' --- 外部系统（System_Ext）-----------------------------------------------
System_Ext(piAgent, "pi coding agent", "运行在用户电脑上的宿主 agent：提供扩展 API、LLM 访问与本地文件存储；对插件是统一的外部系统")
System_Ext(wechatApp, "微信 App", "用户使用的微信客户端：收发消息、扫码确认登录")
System_Ext(ilinkBackend, "微信 iLink 后端", "插件对接的机器人后端 API：长轮询、发送、上传下载、typing、登录鉴权")

' --- 关系（Rel）----------------------------------------------------------
' 终端路径：绑定账号与管理
Rel(user, plugin, "首次使用：在 pi 终端执行 /wechat login 绑定微信账号；查看状态 / 启停轮询", "终端命令")
Rel(plugin, user, "展示登录二维码与连接状态", "终端 / UI 通知")

' 微信路径：聊天（消息经微信平台内部路由）
Rel(user, wechatApp, "收发微信消息、扫码确认登录", "微信 App")
Rel(wechatApp, ilinkBackend, "发送消息 / 扫码确认", "平台内部")
Rel(ilinkBackend, wechatApp, "投递消息 / 登录结果", "平台内部")

Rel(plugin, ilinkBackend, "请求登录二维码 / 长轮询 / 发送回复与媒体 / typing", "HTTPS")
Rel(ilinkBackend, plugin, "返回新消息 / 登录结果", "HTTPS")

' 宿主：插件与 pi coding agent 的交互
Rel(plugin, piAgent, "注册工具 / 命令 / 事件；注入用户消息", "ExtensionAPI（in-process）")

' --- 前置说明 ------------------------------------------------------------
note as Precondition
  **前置条件** — 首次使用需先在 pi 终端执行 `/wechat login` 扫码绑定微信账号；
  绑定成功后插件才会自动连接并收发微信消息（绑定前微信侧无法触达插件）。
end note

LAYOUT_WITH_LEGEND()
@enduml
