@startuml
' ============================================================================
' L4 Code - Engine 类图（PlantUML 原生 class 图，非 C4 宏）
' 范围：src/engine/ 的 7 个协作类 + 依赖注入接口 + 适配层调用面
'
' 事实来源：src/engine/*.ts、docs/ARCHITECTURE.md
' 约定：
'   *--  组合（门面构造并持有）
'   ..>  依赖 / 引用（构造注入或调用）
'   <<facade>> / <<collaborator>> / <<adapter>> / <<module>>
' ============================================================================

skinparam classAttributeIconSize 0
hide empty members

title Class Diagram — Engine (src/engine/)

' ============ 协作类 ============
package "src/engine（协作类）" {

  class WechatEngine <<facade>> {
    - poller : PollingLoop
    - queue : TurnQueue
    - mediaStore : MediaStore
    - mediaQueue : SerialTaskQueue
    - typing : TypingController
    - sender : MessageSender
    - router : MessageRouter
    - host : WechatHost
    - config : WechatConfig
    - singleUserId : string
    - singleContextToken : string
    - accountId : string
    - isTerminalMessageProcessing : boolean
    --
    + connectionState : ConnectionState
    + setHost(host)
    + setConfig(config)
    + setNotifier(fn)
    + configure(deps)
    + initSingleUser() : Promise<boolean>
    + startPolling(opts)
    + stopPolling()
    + handleMessage(msg, opts)
    + triggerAi(msg, requestId, opts)
    + onAiDone()
    + sendTextMessage(text)
    + sendFileToUser(localPath)
    + sendMessageWithRetry(text, maxRetries)
    + getTypingTicket()
    + sendTypingStatus(status)
    + startTypingKeepalive()
    + stopTypingKeepalive()
    + getCurrentRequestId()
    + markRequestProcessed(id)
    + reset()
  }

  class PollingLoop <<collaborator>> {
    - deps : PollingLoopDeps
    - state : syncCursor + connectionState
    - abortController : AbortController
    - consecutiveFailures : number
    - pollingActive : boolean
    - pollingGeneration : number
    --
    + connectionState : ConnectionState
    + start(opts)
    + stop()
    + reset()
    - createAbortWaiter(signal)
  }

  class "TurnQueue<T>" as TurnQueue <<collaborator>> {
    - pending : T[]
    - busy : boolean
    - currentRequestId : string
    - processed : Map
    - cleanupCounter : number
    --
    + enqueue(item)
    + dequeue()
    + isBusy()
    + setBusy(value)
    + getCurrentRequestId()
    + setCurrentRequestId(id)
    + isRequestProcessed(id)
    + markRequestProcessed(id)
    + cleanupProcessedRequests()
    + reset()
  }

  class SerialTaskQueue <<collaborator>> {
    - tail : Promise
    - pending : number
    - onError : callback
    --
    + enqueue(task)
    + idle : boolean
  }

  class MessageRouter <<collaborator>> {
    - deps : RouterDeps
    --
    + execute(msg, requestId, opts)
    + drain()
    - processMediaInBackground(msg, requestId, opts)
  }

  class MediaStore <<collaborator>> {
    - getBasePath : callback
    - log / errLog
    --
    + save(buffer, contentType, originalFilename) : string
    + createSaveCallback() : SaveMediaFn
    + downloadAll(items, cdnBaseUrl, labelPrefix) : string[]
  }

  class TypingController <<collaborator>> {
    - deps : TypingDeps
    - typingTicketCache
    - typingKeepaliveTimer
    --
    + getTicket() : Promise
    + sendStatus(status)
    + startKeepalive()
    + stopKeepalive()
    + invalidateTicket()
    + reset()
  }

  class MessageSender <<collaborator>> {
    - deps : SenderDeps
    --
    + sendText(text)
    + sendFile(localPath)
    + sendWithRetry(text, maxRetries)
  }

  enum ConnectionState {
    disconnected
    connecting
    connected
    error
    needs_relogin
  }
}

' ============ 注入接口 / 类型 ============
package "注入接口 / 类型（deps）" {

  interface WechatHost {
    + appendEntry(customType, data)
    + sendUserMessage(content, options)
    + sendMessage(message, options)
  }

  interface PollingLoopDeps {
    + ensureSession() : Promise
    + getAccountId() : string
    + loadCursor(accountId) : Promise
    + saveCursor(accountId, cursor)
    + onMessage(msg, opts)
    + onNeedsRelogin()
    + sleep(ms)
    + debug / error
  }

  interface RouterDeps {
    + queue : TurnQueue
    + mediaStore : MediaStore
    + mediaQueue : SerialTaskQueue
    + sender : MessageSender
    + getHost() : WechatHost
    + getOpts() : WechatApiOpts
    + logger : PluginLogger
  }

  interface TypingDeps {
    + getCredentials() : TypingCredentials
    + debug / error
  }

  interface SenderDeps {
    + getCredentials() : TypingCredentials
    + debug / error
  }

  class TypingCredentials {
    + baseUrl : string
    + token : string
    + userId : string
    + contextToken : string
  }

  class MediaStoreOptions {
    + getBasePath : callback
    + log / errLog
  }
}

' ============ 适配层（第三方，仅调用面）============
package "Adapter（第三方 · 仅调用面）" {
  class api <<adapter>> {
    + getUpdates()
    + getConfig()
    + sendTyping()
  }
  class messaging <<adapter>> {
    + sendMessageWeixin()
    + sendWeixinMediaFile()
  }
  class media <<adapter>> {
    + downloadMediaFromItem()
  }
}

' ============ 外部依赖 ============
package "外部依赖" {
  class "storage/state" as storage <<module>> {
    + getSingleUserCredentials()
    + getSingleUserContextToken()
    + saveContextToken()
    + loadSyncCursor / saveSyncCursor
  }
  class shared <<module>> {
    config / logger / time / types
  }
}

' ============ 组合（门面构造并持有）============
WechatEngine *-- PollingLoop : poller
WechatEngine *-- TurnQueue : queue
WechatEngine *-- SerialTaskQueue : mediaQueue
WechatEngine *-- MediaStore : mediaStore
WechatEngine *-- TypingController : typing
WechatEngine *-- MessageSender : sender
WechatEngine *-- MessageRouter : router

' ============ 依赖注入 ============
WechatEngine ..> WechatHost : host
PollingLoop ..> PollingLoopDeps : deps
MessageRouter ..> RouterDeps : deps
TypingController ..> TypingDeps : deps
MessageSender ..> SenderDeps : deps

' ============ RouterDeps 引用协作类 ============
RouterDeps ..> TurnQueue
RouterDeps ..> MediaStore
RouterDeps ..> SerialTaskQueue
RouterDeps ..> MessageSender
RouterDeps ..> WechatHost

' ============ 凭证 ============
TypingDeps ..> TypingCredentials
SenderDeps ..> TypingCredentials
WechatEngine ..> TypingCredentials : 组装 getCredentials()

' ============ 适配层调用面 ============
PollingLoop ..> api : getUpdates
TypingController ..> api : getConfig / sendTyping
MessageSender ..> messaging : sendMessageWeixin / sendWeixinMediaFile
MediaStore ..> media : downloadMediaFromItem

' ============ 外部依赖 ============
WechatEngine ..> storage
WechatEngine ..> shared
MediaStore ..> shared
MessageRouter ..> shared : sleep / logger

' ============ 返回类型 ============
PollingLoop ..> ConnectionState : returns

' ============ 说明 ============
note right of WechatEngine
  门面 / 组合根：
  - 构造时创建全部协作类（组合关系）
  - 只依赖窄接口 WechatHost，不依赖整个 ExtensionAPI
  - 导出单例 engine + 工厂 createWechatEngine()
end note

note bottom of RouterDeps
  MessageRouter 仅通过 RouterDeps 依赖窄接口，
  不直接持有 WechatEngine，因此可独立单测。
end note

@enduml
