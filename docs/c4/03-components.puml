@startuml
' ============================================================================
' C4 Level 3 - Component (主图，折叠版)
' 系统：pi-wechat-extension（进程内插件）
'
' 事实来源：docs/ARCHITECTURE.md
' 目的：表达插件内部分层与依赖方向约束（Engine 内部细节见 03a-engine.puml）。
' 抽象：本图以「host 进程」为范围；插件为 scope/边界，其内部为 Components。
' ============================================================================

!include <C4/C4_Component>
!include _styles.puml

title Component Diagram — pi-wechat-extension (inside pi coding agent process)

' --- 外部（图外）---------------------------------------------------------
Person(user, "用户", "在 pi 终端绑定/管理微信账号；通过微信与 AI 对话")
System_Ext(ilink, "微信 iLink 后端", "云端机器人 API：长轮询 / 发送 / 上传下载 / typing / 登录", $tags="external")
ContainerDb(stateDir, "~/.pi/agent/wechat/", "本地文件", "凭证 / cursor / context token / media", $tags="external")

' --- 宿主进程 ------------------------------------------------------------
Container_Boundary(host, "pi coding agent 进程 (Node.js ≥ 22)") {

  Component(piApi, "pi ExtensionAPI", "宿主 API", "pi.on / registerCommand / registerTool / appendEntry / sendUserMessage", $tags="external")

  Container_Boundary(plugin, "pi-wechat-extension（进程内插件）") {

    Component(index, "index", "组合根", "装配 tool / command / event 到 ExtensionAPI", $tags="self")
    Component(bridge, "Bridge", "pi 适配层", "events / turn / meta / commands / tool-send-file / login", $tags="self")
    Component(engine, "Engine", "引擎层", "wechat / polling / queue / router / media-store / typing / sender", $tags="self")
    Component(storage, "Storage", "持久化", "state / state-dir（原子写 + 按路径串行）", $tags="self")
    Component(shared, "Shared", "基础", "config / logger / time / paths / types", $tags="self")
    Component(adapter, "WeChat Adapter", "第三方适配层", "api / auth / cdn / media / messaging / util（vendored from openclaw-weixin）", $tags="thirdparty")
  }
}

' --- 关系（只画允许方向）-------------------------------------------------
Rel(user, bridge, "/wechat login 等终端命令", $tags="allowed")
Rel(index, bridge, "装配 / 注册", $tags="allowed")
Rel(index, engine, "setPi / 单例", $tags="allowed")
Rel(bridge, engine, "调用引擎", $tags="allowed")
Rel(bridge, storage, "凭证 / 账号", $tags="allowed")
Rel(bridge, adapter, "登录 / 脱敏", $tags="allowed")
Rel(bridge, piApi, "事件 / 命令 / 工具 / 注入消息", $tags="event")

Rel(engine, storage, "状态 / cursor", $tags="allowed")
Rel(engine, shared, "配置 / 日志 / 时间", $tags="allowed")
Rel(engine, adapter, "调用公开 API", $tags="allowed")

Rel(storage, stateDir, "读写凭证 / cursor", $tags="allowed")
Rel(engine, stateDir, "媒体落盘 (media-store)", $tags="allowed")
Rel(adapter, ilink, "HTTPS：长轮询 / 发送 / 上传下载 / typing / 登录", $tags="allowed")

' --- 架构约束 ------------------------------------------------------------
note as Constraints
  **硬约束**
  - 依赖方向：index → bridge → engine → shared / storage → adapter
  - 禁止反向：engine / shared 不得 import bridge
  - 禁止：storage 不得 import engine
  - adapter 视为第三方：只调用其公开函数，不修改内部实现
  - Storage / Shared 亦通过 adapter 的 util（日志 / 脱敏）
  - Engine 内部细节见 **03a-engine.puml**
end note

SHOW_LEGEND()
@enduml
