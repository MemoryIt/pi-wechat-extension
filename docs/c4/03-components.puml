@startuml
' ============================================================================
' C4 Level 3 - Component (主图，折叠版)
' 系统：pi-wechat-extension（进程内插件）
'
' 事实来源：docs/ARCHITECTURE.md、src/
' 目的：表达 Ports & Adapters 分层与依赖方向约束
'       （Channel 内部细节见 03a-channel.puml；端口/适配器边界见 03b-ports-adapters.puml）。
' 抽象：本图以「host 进程」为范围；插件为 scope/边界，其内部为 Components。
' ============================================================================

!include <C4/C4_Component>
!include _styles.puml

title Component Diagram — pi-wechat-extension (inside pi coding agent process)

' --- 外部（图外）---------------------------------------------------------
Person(user, "用户", "在 pi 终端绑定/管理微信账号；通过微信与 AI 对话")
System_Ext(ilink, "微信 iLink 后端", "云端机器人 API：长轮询 / 发送 / 上传下载 / typing / 登录", $tags="external")
ContainerDb(stateDir, "~/.pi/agent/wechat/", "本地文件", "凭证 / cursor / context token / media", $tags="external")

' --- 宿主进程 ------------------------------------------------------------
Container_Boundary(host, "pi coding agent 进程 (Node.js ≥ 22)") {

  Component(piApi, "pi ExtensionAPI", "宿主 API", "pi.on / registerCommand / registerTool / appendEntry / sendUserMessage", $tags="external")

  Container_Boundary(plugin, "pi-wechat-extension（进程内插件）") {

    Component(index, "index", "组合根", "createExtension(deps?)：组装 application + PiHost + Channel + WechatAuth", $tags="self")
    Component(application, "Application", "用例层", "reply（ReplyService）/ session（SessionService）/ types（DTO + 窄接口）", $tags="self")
    Component(bridge, "Bridge", "pi 适配层（事件翻译）", "events / turn / meta / commands / session-ui / tool-send-file；只做事件→用例委托，不承载用例", $tags="self")
    Component(channel, "Channel", "通道核心", "channel / state / request-id / polling / queue / router / media-store / typing / sender", $tags="self")
    Component(ports, "Ports", "端口接口", "inbound / outbound / media / auth / pi-host / types", $tags="self")
    Component(adapter, "Adapters", "微信侧薄包装", "inbound / outbound / media / auth（唯一接触 vendor）", $tags="thirdparty")
    Component(storage, "Storage", "持久化", "state / state-dir（原子写 + 按路径串行）", $tags="self")
    Component(shared, "Shared", "基础", "config / logger / time / paths / types / redact / file-logger", $tags="self")
  }
}

' --- 关系（只画允许方向）-------------------------------------------------
Rel(user, bridge, "/wechat login 等终端命令", $tags="allowed")
Rel(index, bridge, "装配 / 注册（注入 BridgeChannel 窄接口）", $tags="allowed")
Rel(index, application, "组装 SessionService / ReplyService 并注入", $tags="allowed")
Rel(index, channel, "new Channel + setHost", $tags="allowed")
Rel(index, adapter, "组装 inbound/outbound/media 端口实现，默认 WechatAuth 工厂", $tags="allowed")
Rel(bridge, application, "事件翻译 → 用例委托（agent_settled / session_*）", $tags="allowed")
Rel(bridge, channel, "调用通道公共方法（窄接口 BridgeChannel）", $tags="allowed")
Rel(bridge, piApi, "事件 / 命令 / 工具 / 注入消息", $tags="event")

Rel(application, channel, "窄接口（ReplyChannel / SessionChannel）", $tags="allowed")
Rel(application, ports, "WechatAuth（登录端口）", $tags="allowed")
Rel(application, storage, "凭证读写（token / account）", $tags="allowed")

Rel(channel, ports, "依赖端口接口", $tags="allowed")
Rel(channel, storage, "凭证 / cursor / context token", $tags="allowed")
Rel(channel, shared, "配置 / 日志 / 时间", $tags="allowed")
Rel(adapter, ports, "实现端口", $tags="allowed")

Rel(storage, stateDir, "读写凭证 / cursor", $tags="allowed")
Rel(channel, stateDir, "媒体落盘 (media-store)", $tags="allowed")
Rel(adapter, ilink, "HTTPS：长轮询 / 发送 / 上传下载 / typing / 登录", $tags="allowed")

' --- 架构约束 ------------------------------------------------------------
note as Constraints
  **硬约束**
  - 依赖方向：index → bridge / application / adapters / channel / ports
  - bridge → application（事件翻译→用例委托）/ channel（窄接口）/ shared；
    application → channel（ReplyChannel / SessionChannel 窄接口）/ ports（WechatAuth）/ storage / shared
  - channel → ports / storage / shared；adapters → ports + vendor；ports → 仅 types.ts 转发 vendor 协议类型
  - bridge 只做事件翻译，不承载用例；application 承载用例（SessionService / ReplyService），
    **application 不依赖 pi / vendor / 具体 Channel**（只经窄接口与 DTO 协作）
  - 禁止反向：bridge / channel / ports / adapters / shared 不得 import bridge；
    channel 不得 import bridge；storage 不得 import channel / bridge
  - vendor（api / auth / cdn / media / messaging / util）只允许被 adapters
    （及 ports/types、shared/redact、shared/file-logger 两个再导出边界）引用
  - index 组装 adapters（inbound/outbound/media）与 ChannelState 并注入 Channel；
    channel 只依赖 ports / storage / shared
  - Channel 内部细节见 **03a-channel.puml**；端口/适配器边界见 **03b-ports-adapters.puml**
end note

SHOW_LEGEND()
@enduml
