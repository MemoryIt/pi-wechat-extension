@startuml
' ============================================================================
' L4 Code - Channel 类图（PlantUML 原生 class 图，非 C4 宏）
' 范围：src/channel/ 的编排器 + 状态 + 协作类 + 端口接口 + 注入 deps
'
' 事实来源：src/channel/*.ts、src/ports/*.ts、docs/ARCHITECTURE.md
' 约定：
'   *--  组合（构造并持有）
'   ..>  依赖 / 引用（构造注入或调用）
'   <<orchestrator>> / <<state>> / <<collaborator>> / <<port>> / <<deps>> / <<module>>
' 附注：bridge / tool / application 不依赖具体 Channel，只依赖窄接口
'       （BridgeChannel / SendFileChannel / ReplyChannel / SessionChannel，见 docs/ARCHITECTURE.md §4.10）。
' ============================================================================

skinparam classAttributeIconSize 0
hide empty members

title Class Diagram — Channel (src/channel/)

' ============ 编排器 + 状态 + 协作类 ============
package "src/channel（编排器 + 状态 + 协作类）" {

  class Channel <<orchestrator>> {
    + state : ChannelState
    - logger : PluginLogger
    - credentialLoader : CredentialLoader
    - poller : PollingLoop
    - typing : TypingController
    - sender : MessageSender
    - router : MessageRouter
    - inboundHandler : InboundHandler
    --
    + constructor(deps : ChannelDeps)（委托 createChannelRuntime 装配）
    --
    + connectionState : ConnectionState
    + setHost(host : PiHost)
    + setNotifier(notifier : Notifier)
    + setConfig(config : WechatApiOpts)
    + setTerminalProcessing(value)
    + initSession() : Promise<boolean>
    + stopPolling()
    + startPolling(opts : WechatApiOpts) : Promise<void>
    + handleMessage(msg, opts) : Promise<void>
    + triggerAi(msg, requestId, opts) : Promise<void>
    + onAiDone()
    + startTyping() : Promise<void>
    + stopTyping() : Promise<void>
    + sendFile(localPath) : Promise<void>
    + sendReply(text, maxRetries?) : Promise<void>
    + isRequestProcessed(id) : boolean
    + markRequestProcessed(id)
    + reset()
  }

  class ChannelState <<state>> {
    + accountId : string | null
    + userId : string | null
    + contextToken : string | null
    + config : WechatApiOpts | null
    + host : PiHost | null
    + notifier : Notifier | null
    + isTerminalMessageProcessing : boolean
    --
    + resetSession()
    + getCredentials() : WechatCredentials | null
    + getOpts() : WechatApiOpts | null
  }

  class RequestIdGenerator <<collaborator>> {
    - lastMs : number
    - seq : number
    --
    + next(now?) : string（YYMMDDHHMMSSmmm + 3 位序号）
  }

  class InboundHandler <<collaborator>> {
    - deps : InboundHandlerDeps
    - requestId : RequestIdGenerator
    --
    + handle(msg, opts) : Promise<void>
  }

  class CredentialLoader <<collaborator>> {
    - state : ChannelState
    - logger : PluginLogger
    --
    + ensureSession() : Promise<boolean>
  }

  class "createChannelRuntime" as createChannelRuntime <<module>> {
    - deps : ChannelDeps（import type）
    --
    + createChannelRuntime(deps) : ChannelRuntime
  }

  class "parseInbound" as parseInbound <<module>> {
    + parseInbound(msg) : ParsedInbound
  }

  class PollingLoop <<collaborator>> {
    - deps : PollingLoopDeps
    - state : syncCursor + connectionState
    - abortController : AbortController
    - consecutiveFailures : number
    - pollingActive : boolean
    - pollingGeneration : number
    --
    + connectionState : ConnectionState
    + start(opts : WechatApiOpts) : Promise<void>
    + stop()
    + reset()
    - createAbortWaiter(signal)
  }

  class "TurnQueue<T>" as TurnQueue <<collaborator>> {
    - pending : T[]
    - busy : boolean
    - currentRequestId : string | null
    - processed : Map<string, number>
    - cleanupCounter : number
    --
    + size : number
    + isBusy() : boolean
    + setBusy(value)
    + getCurrentRequestId() : string | null
    + setCurrentRequestId(id)
    + enqueue(item)
    + dequeue() : T | undefined
    + isRequestProcessed(id) : boolean
    + markRequestProcessed(id)
    + cleanupProcessedRequests()
    + reset()
  }

  class SerialTaskQueue <<collaborator>> {
    - tail : Promise<void>
    - pending : number
    - onError : (err) => void
    --
    + enqueue(task : () => Promise<void>)
    + idle : boolean
  }

  class MessageRouter <<collaborator>> {
    - deps : RouterDeps
    + queue : TurnQueue<{ msg, requestId }>
    --
    + dispatch(msg, requestId, opts) : Promise<void>
    + onTurnDone()
    + execute(msg, requestId, opts) : Promise<void>
    + drain() : Promise<void>
    - processMediaInBackground(msg, requestId, opts) : Promise<void>
  }

  class MediaStore <<collaborator>> {
    - getBasePath : () => string
    - media : WechatMedia
    - log / errLog
    --
    + save(buffer, contentType?, originalFilename?) : string
    + createSaveCallback() : SaveMediaFn
    + downloadAll(items, cdnBaseUrl, labelPrefix?) : Promise<string[]>
  }

  class TypingController <<collaborator>> {
    - deps : TypingDeps
    - typingTicketCache
    - typingKeepaliveTimer
    --
    + getTicket() : Promise<string | null>
    + sendStatus(status : 1 | 2) : Promise<void>
    + startKeepalive() : Promise<void>
    + stopKeepalive() : Promise<void>
    + invalidateTicket()
    + reset()
  }

  class MessageSender <<collaborator>> {
    - deps : SenderDeps
    --
    + sendText(text) : Promise<void>
    + sendFile(localPath) : Promise<void>
    + sendWithRetry(text, maxRetries?) : Promise<void>
  }

  enum ConnectionState {
    disconnected
    connecting
    connected
    error
    needs_relogin
  }

  class "Notifier" as Notifier <<type>> {
    (message, type?) => void
  }
}

' ============ 端口接口 ============
package "Ports（src/ports/）" {
  interface WechatInbound <<port>> {
    + getUpdates(params) : Promise<WechatInboundGetUpdatesResult>
  }
  interface WechatOutbound <<port>> {
    + sendText(text) : Promise<void>
    + sendFile(localPath) : Promise<void>
    + sendTyping(status, ticket) : Promise<void>
    + getTypingTicket() : Promise<string | null>
  }
  interface WechatMedia <<port>> {
    + download(item, deps) : Promise<WechatMediaDownloadResult | null>
  }
  interface WechatAuth <<port>> {
    + startQr(opts) : Promise<WechatAuthStartQrResult>
    + waitForLogin(opts) : Promise<WechatAuthWaitForLoginResult>
  }
  interface PiHost <<port>> {
    + appendEntry(customType, data)
    + sendUserMessage(content, options)
    + sendMessage(message, options)
  }
}

' ============ 注入 deps / 类型 ============
package "注入 deps / 类型" {
  interface ChannelDeps <<deps>> {
    + state? : ChannelState
    + host? : PiHost
    + config? : WechatApiOpts
    + notifier? : Notifier
    + ports : ChannelPorts
    + logger? : PluginLogger
    + sleep? : (ms) => Promise<void>
  }
  interface ChannelPorts <<deps>> {
    + inbound : WechatInbound
    + outbound : WechatOutbound
    + media : WechatMedia
  }
  interface PollingLoopDeps <<deps>> {
    + ensureSession() : Promise<boolean>
    + getAccountId() : string | null
    + loadCursor(accountId) : Promise<string | null>
    + saveCursor(accountId, cursor) : Promise<void>
    + inbound : WechatInbound
    + onMessage(msg, opts) : Promise<void>
    + onNeedsRelogin()
    + debug / error
    + sleep(ms) : Promise<void>
  }
  interface RouterDeps <<deps>> {
    + queue? : TurnQueue
    + mediaStore : MediaStore
    + mediaQueue : SerialTaskQueue
    + sender : MessageSender
    + getHost() : PiHost | null
    + getOpts() : WechatApiOpts | null
    + isTerminalProcessing() : boolean
    + logger : PluginLogger
  }
  interface InboundHandlerDeps <<deps>> {
    + state : ChannelState
    + typing : InboundTyping
    + router : InboundDispatch
    + requestId : RequestIdGenerator
    + logger : PluginLogger
  }
  interface CredentialLoaderDeps <<deps>> {
    + state : ChannelState
    + logger : PluginLogger
  }
  interface ChannelRuntime <<deps>> {
    + state / logger / credentialLoader / poller
    + typing / sender / router / inboundHandler
  }
  class ParsedInbound <<type>> {
    + text : string
    + hasText : boolean
    + hasMedia : boolean
  }
  interface TypingDeps <<deps>> {
    + outbound : WechatOutbound
    + getContextToken() : string | null
    + debug / error
  }
  interface SenderDeps <<deps>> {
    + outbound : WechatOutbound
    + canSend() : boolean
    + debug / error
  }
  interface MediaStoreOptions <<deps>> {
    + getBasePath? : () => string
    + media? : WechatMedia
    + log? / errLog?
  }
  class SaveMediaFn <<type>> {
    (buffer, contentType?, originalFilename?) => Promise<WechatMediaDownloadResult>
  }
  class WechatCredentials <<type>> {
    + baseUrl : string
    + token : string
    + userId : string
    + contextToken : string
  }
  class WechatApiOpts <<type>> {
    + baseUrl : string
    + token : string
  }
}

' ============ 外部依赖 ============
package "外部依赖" {
  class "storage/state" as storage <<module>> {
    + getSingleUserCredentials()
    + getDefaultAccountToken()
    + getSingleUserContextToken()
    + saveContextToken()
    + loadSyncCursor / saveSyncCursor
  }
  class "shared" as shared <<module>> {
    config / logger / time / types
  }
  class "index（组合根）" as index <<module>> {
    createExtension：组装 ChannelState + adapters + Channel
  }
  class "adapters（组合根组装）" as adapters <<module>> {
    createWechatInbound / createWechatOutbound / createWechatMedia / createWechatAuth
  }
}

' ============ 组合（持有）============
Channel *-- ChannelState : state
Channel *-- CredentialLoader : credentialLoader
Channel *-- PollingLoop : poller
Channel *-- TypingController : typing
Channel *-- MessageSender : sender
Channel *-- MessageRouter : router
Channel *-- InboundHandler : inboundHandler

' 协作类拥有的对象
MessageRouter *-- TurnQueue : queue（turn 编排唯一入口）
InboundHandler *-- RequestIdGenerator : requestId

' ============ 构造注入 ============
Channel ..> createChannelRuntime : 委托装配（createChannelRuntime(deps)）
Channel ..> ChannelDeps : constructor(deps)
ChannelDeps ..> ChannelPorts
ChannelDeps ..> ChannelState
ChannelDeps ..> Notifier
ChannelDeps ..> WechatApiOpts
ChannelDeps ..> PiHost
createChannelRuntime ..> ChannelDeps : deps
createChannelRuntime ..> ChannelRuntime : returns

' ============ 协作类 → deps → 端口 ============
PollingLoop ..> PollingLoopDeps : deps
PollingLoopDeps ..> WechatInbound
PollingLoopDeps ..> WechatApiOpts
PollingLoop ..> ConnectionState : returns

MessageRouter ..> RouterDeps : deps
RouterDeps ..> TurnQueue
RouterDeps ..> MediaStore
RouterDeps ..> SerialTaskQueue
RouterDeps ..> MessageSender
RouterDeps ..> PiHost
RouterDeps ..> WechatApiOpts
MessageRouter ..> parseInbound : 使用
parseInbound ..> ParsedInbound : returns

InboundHandler ..> InboundHandlerDeps : deps
InboundHandlerDeps ..> ChannelState
InboundHandlerDeps ..> RequestIdGenerator
InboundHandlerDeps ..> TypingController
InboundHandlerDeps ..> MessageRouter

CredentialLoader ..> CredentialLoaderDeps : deps
CredentialLoaderDeps ..> ChannelState

TypingController ..> TypingDeps : deps
TypingDeps ..> WechatOutbound

MessageSender ..> SenderDeps : deps
SenderDeps ..> WechatOutbound

MediaStore ..> MediaStoreOptions : opts
MediaStoreOptions ..> WechatMedia
MediaStore ..> SaveMediaFn
MediaStore ..> WechatMedia : downloadAll

ChannelPorts ..> WechatInbound
ChannelPorts ..> WechatOutbound
ChannelPorts ..> WechatMedia

' ============ adapters 实现端口 ============
adapters ..> WechatInbound : 实现
adapters ..> WechatOutbound : 实现
adapters ..> WechatMedia : 实现
adapters ..> WechatAuth : 实现

' ============ 协作类 / Channel → 外部依赖 ============
Channel ..> PiHost : setHost / state.host
Channel ..> shared : 日志接口（PluginLogger）
createChannelRuntime ..> shared : 配置 / 日志 / 时间
InboundHandler ..> storage : saveContextToken
CredentialLoader ..> storage : 读取凭证 / context token
index ..> adapters : 组装端口实现
index ..> Channel : new Channel({ state, ports, logger })
index ..> ChannelState : new ChannelState()
ChannelState ..> WechatCredentials : getCredentials / getOpts

' ============ 说明 ============
note right of Channel
  facade：
  - 构造函数仅调用 createChannelRuntime(deps) 并把结果赋给自身字段
  - 只持有 state / logger / credentialLoader / poller / typing / sender / router / inboundHandler
  - 对外仅委托：handleMessage → InboundHandler，triggerAi/onAiDone → MessageRouter，
    initSession → CredentialLoader，startPolling/stopPolling → PollingLoop，
    startTyping/stopTyping → TypingController，sendFile/sendReply → MessageSender
  - 不直接持有 queue / mediaStore / mediaQueue / sleep / requestId（由工厂装配，或由协作类拥有）
  - requestId 由 InboundHandler 持有的 RequestIdGenerator 生成，不保存在 ChannelState 中
  - 无模块级单例；createExtension() 每次新建独立实例
end note

note right of InboundHandler
  入站处理：requestId = requestId.next() → 按需同步 contextToken
  （typing.invalidateTicket + 条件 storage.saveContextToken）→ router.dispatch。
end note

note right of CredentialLoader
  从 storage 读取单用户凭证写入 ChannelState（原 Channel.initSession），
  poller 与 Channel.initSession 均委托此协作类。
end note

note right of createChannelRuntime
  内部装配工厂：创建全部协作类并注入回调（行为与抽取前的 Channel
  构造函数逐字等价）；返回 ChannelRuntime 供 Channel 持有。
end note

note bottom of parseInbound
  纯函数：把 item_list 归一为 { text, hasText, hasMedia }，供 MessageRouter 复用。
end note

note right of ChannelState
  requestId 追踪已迁出：不再保存同毫秒序号等 requestId 追踪字段
  （生成职责由 RequestIdGenerator 承担，见 request-id.ts）。
end note

note bottom of Channel
  bridge / application / tool 均不依赖具体 Channel 类，只依赖窄接口：
  - BridgeChannel（setNotifier / setTerminalProcessing / startTyping / stopTyping）
  - SendFileChannel（sendFile）
  - ReplyChannel（isRequestProcessed / stopTyping / sendReply / markRequestProcessed /
    setTerminalProcessing / onAiDone）
  - SessionChannel（connectionState / setConfig / startPolling / stopPolling / reset）
end note

note bottom of RouterDeps
  MessageRouter 仅通过 RouterDeps 依赖窄接口，
  不直接持有 Channel，因此可独立单测。
end note

note bottom of WechatAuth
  WechatAuth 不由 Channel 使用：
  index 构造 createWechatAuth() 并交给 application/session（登录用例）。
end note

@enduml
